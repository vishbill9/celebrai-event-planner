# Copy to .env for local development. Never commit the real file.
# On Render, set these in the dashboard (Environment tab), not in the repository.

# --- Ollama Cloud (AI) ---
# Secret. Server only.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=glm-5.3
# Optional comma-separated backup models, tried in order if the main model fails or answers empty.
# Default: nemotron-3-super,beam:cloud   Set to off to disable.
OLLAMA_FALLBACK_MODEL=nemotron-3-super,beam:cloud
# Optional faster model used only for the new-event chat (empty = use OLLAMA_MODEL)
OLLAMA_CHAT_MODEL=
# Optional: limit for one AI request in milliseconds (default 60000)
OLLAMA_TIMEOUT_MS=60000

# --- Supabase ---
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Public anon key. Safe for the browser; protected by row level security.
SUPABASE_ANON_KEY=
# Secret. Server only. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Server ---
NODE_ENV=development
# Render injects PORT automatically. Locally it defaults to 8080.
PORT=8080
# Public URL of the app, e.g. https://celebrai-event-planner.onrender.com
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed browser origins for cross-origin API calls.
CORS_ORIGIN=http://localhost:5173
# Optional: pino log level (default info)
LOG_LEVEL=info
